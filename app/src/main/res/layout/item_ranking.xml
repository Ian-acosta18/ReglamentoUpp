<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRanking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvRankingPosition"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/white_circle_bg"
            android:backgroundTint="#9C27B0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/ivRankingProfile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_profile"
            app:layout_constraintStart_toEndOf="@id/tvRankingPosition"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvRankingName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nombre Jugador"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/ivRankingProfile"
            app:layout_constraintTop_toTopOf="@+id/ivRankingProfile"
            app:layout_constraintEnd_toStartOf="@+id/linearLayoutScore"
            app:layout_constraintBottom_toTopOf="@+id/tvRankingLevel"/>

        <TextView
            android:id="@+id/tvRankingLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivel 1"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/ivRankingProfile"
            app:layout_constraintTop_toBottomOf="@id/tvRankingName"
            app:layout_constraintBottom_toBottomOf="@+id/ivRankingProfile"/>

        <ImageView
            android:id="@+id/ivTrophy"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_trophy"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvRankingLevel"
            app:layout_constraintTop_toTopOf="@id/tvRankingLevel"
            app:layout_constraintBottom_toBottomOf="@id/tvRankingLevel"/>

        <LinearLayout
            android:id="@+id/linearLayoutScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvRankingScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150"
                android:textColor="#FF9800"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="pts"
                android:textColor="#757575"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>