<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRanking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvRankingPosition"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/white_circle_bg"
            android:backgroundTint="#9C27B0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivRankingProfile"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:src="@drawable/ic_profile"
            app:layout_constraintStart_toEndOf="@id/tvRankingPosition"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvRankingName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nombre Jugador"
            android:textColor="#212121"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/ivRankingProfile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvRankingScore"
            app:layout_constraintBottom_toTopOf="@+id/tvRankingLevel"/>

        <TextView
            android:id="@+id/tvRankingLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivel 1"
            android:textColor="#757575"
            android:textSize="13sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toEndOf="@id/ivRankingProfile"
            app:layout_constraintTop_toBottomOf="@id/tvRankingName"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/tvRankingLevel"
            app:layout_constraintTop_toTopOf="@id/tvRankingLevel"
            app:layout_constraintBottom_toBottomOf="@id/tvRankingLevel">

            <ImageView
                android:id="@+id/badge1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_trophy"
                android:layout_marginEnd="6dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/badge2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_foco"
                android:layout_marginEnd="6dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/badge3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_games"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRankingScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150 pts"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>