<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_purple_curve"
                android:paddingBottom="50dp">

                <LinearLayout
                    android:id="@+id/headerContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="50dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:padding="4dp"
                        android:background="@drawable/white_circle_bg"
                        android:src="@drawable/mi_logo"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"/>

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#33FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tvUserPuntaje"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 XP"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/ivBadge1"
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:src="@drawable/ic_reconocimientos"
                            app:tint="@color/upp_accent" android:alpha="0.6" android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:id="@+id/ivBadge2"
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:src="@drawable/ic_reconocimientos"
                            app:tint="@color/upp_accent" android:alpha="0.6" android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:id="@+id/ivBadge3"
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:src="@drawable/ic_reconocimientos"
                            app:tint="@color/upp_accent" android:alpha="0.6"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnLogout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/white"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-30dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="80dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zona Arcade"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="12dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnJugarModoDesafio"
                        android:layout_width="120dp"
                        android:layout_height="140dp"
                        android:layout_margin="8dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/white_circle_bg"
                                android:backgroundTint="#F3E5F5">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_reconocimientos"
                                    android:layout_gravity="center"
                                    app:tint="@color/upp_primary"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Desafío"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="12dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnJugarVerdaderoFalso"
                        android:layout_width="120dp"
                        android:layout_height="140dp"
                        android:layout_margin="8dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/white_circle_bg"
                                android:backgroundTint="#E0F2F1">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:layout_gravity="center"
                                    app:tint="#009688"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="V / F"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="12dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnJugarAhorcado"
                        android:layout_width="120dp"
                        android:layout_height="140dp"
                        android:layout_margin="8dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/white_circle_bg"
                                android:backgroundTint="#FFEBEE">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_prohibiciones"
                                    android:layout_gravity="center"
                                    app:tint="#D32F2F"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ahorcado"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="12dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Niveles de Aprendizaje"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/llMenuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarDerechos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivDerechos"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_derechos"
                            app:tint="@color/upp_primary"
                            android:background="@drawable/white_circle_bg"
                            android:backgroundTint="#F3E5F5"
                            android:padding="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:id="@+id/tvDerechos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Derechos"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comenzar"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_send"
                            app:tint="@color/upp_primary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarObligaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/game_locked"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/ivObligaciones"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_obligaciones"
                            android:padding="10dp"
                            app:tint="@color/game_locked_icon"/>
                        <TextView
                            android:id="@+id/tvObligaciones"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Obligaciones"
                            android:textStyle="bold"
                            android:textColor="@color/game_locked_icon"/>
                        <ImageView
                            android:id="@+id/ivLockObligaciones"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/game_locked_icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarProhibiciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/game_locked"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView android:id="@+id/ivProhibiciones" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_prohibiciones" android:padding="10dp" app:tint="@color/game_locked_icon"/>
                        <TextView android:id="@+id/tvProhibiciones" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Prohibiciones" android:textStyle="bold" android:textColor="@color/game_locked_icon"/>
                        <ImageView android:id="@+id/ivLockProhibiciones" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lock" app:tint="@color/game_locked_icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarSanciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/game_locked"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView android:id="@+id/ivSanciones" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_sanciones" android:padding="10dp" app:tint="@color/game_locked_icon"/>
                        <TextView android:id="@+id/tvSanciones" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Sanciones" android:textStyle="bold" android:textColor="@color/game_locked_icon"/>
                        <ImageView android:id="@+id/ivLockSanciones" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lock" app:tint="@color/game_locked_icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarReconocimientos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    app:cardBackgroundColor="@color/game_locked"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView android:id="@+id/ivReconocimientos" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_reconocimientos" android:padding="10dp" app:tint="@color/game_locked_icon"/>
                        <TextView android:id="@+id/tvReconocimientos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Reconocimientos" android:textStyle="bold" android:textColor="@color/game_locked_icon"/>
                        <ImageView android:id="@+id/ivLockReconocimientos" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lock" app:tint="@color/game_locked_icon"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>