<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:contentScrim="@color/upp_primary"
            app:titleEnabled="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/modern_header_gradient"
                android:paddingTop="16dp"
                android:paddingBottom="70dp"
                android:elevation="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLogout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#20FFFFFF"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_lock"
                        android:rotation="180"
                        android:padding="10dp"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/headerContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="8dp"
                        app:strokeColor="#80FFFFFF"
                        app:strokeWidth="3dp"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:id="@+id/ivUserAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:src="@drawable/mi_logo"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Cargando..."
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#30FFFFFF"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#60FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_reconocimientos"
                                app:tint="#FFD700"/>

                            <TextView
                                android:id="@+id/tvUserPuntaje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="0 XP"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/ivBadge1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_reconocimientos"
                            app:tint="#FFD700"
                            android:alpha="0.3"
                            android:layout_marginEnd="10dp"/>
                        <ImageView
                            android:id="@+id/ivBadge2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_reconocimientos"
                            app:tint="#FFD700"
                            android:alpha="0.3"
                            android:layout_marginEnd="10dp"/>
                        <ImageView
                            android:id="@+id/ivBadge3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_reconocimientos"
                            app:tint="#FFD700"
                            android:alpha="0.3"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-50dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/llMenuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="50dp">

            <!-- Sección Juegos Rápidos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="⚡ Juegos Rápidos"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnJugarModoDesafio"
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:layout_marginEnd="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/gradient_card_purple"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/ic_reconocimientos"
                                app:tint="@color/white"
                                android:background="@drawable/white_circle_bg"
                                android:backgroundTint="#40FFFFFF"
                                android:padding="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:text="Trivia"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Opción múltiple"
                                android:textColor="#E0FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnJugarVerdaderoFalso"
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:layout_marginEnd="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/gradient_card_green"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/white"
                                android:background="@drawable/white_circle_bg"
                                android:backgroundTint="#40FFFFFF"
                                android:padding="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:text="V / F"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Verdadero o Falso"
                                android:textColor="#E0FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnJugarAhorcado"
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/gradient_card_red"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/ic_prohibiciones"
                                app:tint="@color/white"
                                android:background="@drawable/white_circle_bg"
                                android:backgroundTint="#40FFFFFF"
                                android:padding="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:text="Ahorcado"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Adivina la palabra"
                                android:textColor="#E0FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Sección Tu Camino -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="20dp"
                android:text="🎯 Tu Camino"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- Nivel 1: Derechos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarDerechos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <View
                            android:id="@+id/progressIndicator"
                            android:layout_width="6dp"
                            android:layout_height="0dp"
                            android:background="@drawable/gradient_vertical_primary"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconCard1"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E1F5FE"
                            app:layout_constraintStart_toEndOf="@id/progressIndicator"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/ivDerechos"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:src="@drawable/ic_derechos"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toEndOf="@id/iconCard1"
                            app:layout_constraintEnd_toStartOf="@id/ivPlayIcon1"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/tvDerechos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Derechos"
                                android:textSize="20sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Nivel 1 • Desbloqueado"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivPlayIcon1"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_send"
                            app:tint="@color/upp_primary"
                            android:layout_marginEnd="4dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nivel 2: Obligaciones -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarObligaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconCard2"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8E8E8"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/ivObligaciones"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:src="@drawable/ic_obligaciones"
                                app:tint="@color/game_locked"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toEndOf="@id/iconCard2"
                            app:layout_constraintEnd_toStartOf="@id/ivLockObligaciones"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/tvObligaciones"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Obligaciones"
                                android:textSize="20sp"
                                android:textColor="@color/game_locked"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Nivel 2 • 50 XP requeridos"
                                android:textSize="13sp"
                                android:textColor="@color/game_locked"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivLockObligaciones"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/game_locked"
                            android:layout_marginEnd="4dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nivel 3: Prohibiciones -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarProhibiciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconCard3"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8E8E8"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/ivProhibiciones"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:src="@drawable/ic_prohibiciones"
                                app:tint="@color/game_locked"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toEndOf="@id/iconCard3"
                            app:layout_constraintEnd_toStartOf="@id/ivLockProhibiciones"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/tvProhibiciones"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prohibiciones"
                                android:textSize="20sp"
                                android:textColor="@color/game_locked"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Nivel 3 • 100 XP requeridos"
                                android:textSize="13sp"
                                android:textColor="@color/game_locked"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivLockProhibiciones"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/game_locked"
                            android:layout_marginEnd="4dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nivel 4: Sanciones -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarSanciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconCard4"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8E8E8"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/ivSanciones"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:src="@drawable/ic_sanciones"
                                app:tint="@color/game_locked"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toEndOf="@id/iconCard4"
                            app:layout_constraintEnd_toStartOf="@id/ivLockSanciones"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/tvSanciones"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sanciones"
                                android:textSize="20sp"
                                android:textColor="@color/game_locked"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Nivel 4 • 150 XP requeridos"
                                android:textSize="13sp"
                                android:textColor="@color/game_locked"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivLockSanciones"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/game_locked"
                            android:layout_marginEnd="4dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nivel 5: Reconocimientos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnJugarReconocimientos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconCard5"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8E8E8"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/ivReconocimientos"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:src="@drawable/ic_reconocimientos"
                                app:tint="@color/game_locked"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toEndOf="@id/iconCard5"
                            app:layout_constraintEnd_toStartOf="@id/ivLockReconocimientos"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/tvReconocimientos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reconocimientos"
                                android:textSize="20sp"
                                android:textColor="@color/game_locked"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Nivel 5 • 200 XP requeridos"
                                android:textSize="13sp"
                                android:textColor="@color/game_locked"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivLockReconocimientos"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/game_locked"
                            android:layout_marginEnd="4dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>