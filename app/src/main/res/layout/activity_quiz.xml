<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background"
    android:padding="24dp"
    tools:context=".QuizActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#AA000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/tvQuizLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ 3"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"/>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#AA000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/tvQuizScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pts: 0"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/quizProgressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="20dp"
        android:progressDrawable="@drawable/gradient_header"
        android:max="10"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCharacter"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/quizProgressBar"
        app:layout_constraintBottom_toTopOf="@+id/cardQuestion">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieCharacter"
            android:layout_width="130dp"
            android:layout_height="130dp"
            app:lottie_rawRes="@raw/smilling_cloud"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="16dp"/>

        <TextView
            android:id="@+id/tvSpeechBubble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/white_circle_bg"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:text="¡Tú puedes!"
            android:textColor="@color/upp_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:elevation="4dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/lottieCharacter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lottieCharacter"
            app:layout_constraintBottom_toBottomOf="@id/lottieCharacter"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="-16dp"
            tools:visibility="visible"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/layoutCharacter"
        app:layout_constraintBottom_toTopOf="@id/btnQuizOptionA">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREGUNTA"
                    android:textColor="#9C27B0"
                    android:letterSpacing="0.12"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvQuizQuestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando pregunta..."
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnQuizOptionA"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_quiz_default"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="Opción A"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@id/btnQuizOptionB" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnQuizOptionB"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_quiz_default"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="Opción B"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@id/btnQuizOptionC" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnQuizOptionC"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_quiz_default"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="Opción C"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>