<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background"
    android:padding="24dp"
    tools:context=".QuizActivity">

    <!-- Barra superior con información -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Vidas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#AA000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/tvQuizLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ 3"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"/>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Puntaje -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#AA000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/tvQuizScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pts: 0"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/quizProgressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="20dp"
        android:progressDrawable="@drawable/gradient_header"
        android:max="10"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Tarjeta de la pregunta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/quizProgressBar"
        app:layout_constraintBottom_toTopOf="@id/btnQuizOptionA">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <!-- Etiqueta PREGUNTA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREGUNTA"
                    android:textColor="@color/upp_primary"
                    android:letterSpacing="0.12"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"/>

                <!-- Texto de la pregunta -->
                <TextView
                    android:id="@+id/tvQuizQuestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando pregunta..."
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="6dp"/>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Opción A -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuizOptionA"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Opción A"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp"
        app:backgroundTint="#33FFFFFF"
        app:cornerRadius="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnQuizOptionB"/>

    <!-- Botón Opción B -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuizOptionB"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Opción B"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp"
        app:backgroundTint="#33FFFFFF"
        app:cornerRadius="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnQuizOptionC"/>

    <!-- Botón Opción C -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuizOptionC"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Opción C"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp"
        app:backgroundTint="#33FFFFFF"
        app:cornerRadius="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>