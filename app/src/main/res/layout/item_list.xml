<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Contenedor del icono -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/white_circle_bg"
            android:backgroundTint="#F3E5F5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/item_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                tools:src="@drawable/ic_derechos" />
        </FrameLayout>

        <!-- Información del título -->
        <LinearLayout
            android:id="@+id/titleSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toEndOf="@+id/icon_container"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_icon"
            app:layout_constraintTop_toTopOf="@+id/icon_container"
            app:layout_constraintBottom_toBottomOf="@+id/icon_container">

            <TextView
                android:id="@+id/tv_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DERECHO"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/upp_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reglamento Escolar"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Icono de check -->
        <ImageView
            android:id="@+id/iv_check_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/game_success"
            android:alpha="0.85"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/icon_container"
            app:layout_constraintBottom_toBottomOf="@+id/icon_container"/>

        <!-- Divisor suave -->
        <View
            android:id="@+id/divider_soft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#F5F5F5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_container"/>

        <!-- Descripción del artículo -->
        <TextView
            android:id="@+id/tv_item_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="El alumno tiene derecho a recibir una educación de calidad conforme a los planes de estudio..."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_soft" />

        <!-- Botón de caso de estudio -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_case_study"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingVertical="14dp"
            android:text="Analizar Caso Práctico"
            android:textColor="@color/upp_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#F3E5F5"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_send"
            app:iconTint="@color/upp_primary"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>