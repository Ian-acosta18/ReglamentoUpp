<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingHorizontal="24dp"
    android:paddingBottom="32dp"
    android:paddingTop="12dp"
    app:behavior_peekHeight="600dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="#D0D0D0"/>

    <TextView
        android:id="@+id/tv_quiz_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Desafío Rápido"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:textColor="@color/upp_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/white_circle_bg"
        android:backgroundTint="#F3E5F5"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:layout_marginBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp">

        <TextView
            android:id="@+id/tv_quiz_pregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Cargando pregunta..."
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.2"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieFeedback"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:lottie_loop="false"
            app:lottie_autoPlay="false"
            app:lottie_renderMode="automatic"/>

        <ProgressBar
            android:id="@+id/progress_bar_quiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/upp_primary"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_quiz_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        tools:text="¡Respuesta Correcta!"
        tools:visibility="visible"/>

    <LinearLayout
        android:id="@+id/quiz_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_a"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/upp_primary"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/white"
            android:textColor="@color/upp_primary_dark"
            android:textAlignment="textStart"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check_circle"
            app:iconTint="@color/upp_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            tools:text="A) Opción de ejemplo uno" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_b"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/upp_primary"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/white"
            android:textColor="@color/upp_primary_dark"
            android:textAlignment="textStart"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check_circle"
            app:iconTint="@color/upp_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            tools:text="B) Opción de ejemplo dos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_c"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/upp_primary"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/white"
            android:textColor="@color/upp_primary_dark"
            android:textAlignment="textStart"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check_circle"
            app:iconTint="@color/upp_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            tools:text="C) Opción de ejemplo tres" />

    </LinearLayout>

</LinearLayout>