<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ReglamentoUpp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/upp_primary</item>
        <item name="colorPrimaryVariant">@color/upp_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/upp_accent</item>
        <item name="colorSecondaryVariant">@color/upp_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ReglamentoUpp.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ReglamentoUpp.MediumComponent</item>
    </style>

    <style name="ShapeAppearance.ReglamentoUpp.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.ReglamentoUpp.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>